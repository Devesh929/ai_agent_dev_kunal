
pkg install -y clang coreutils procps

mkdir -p "$HOME/output 1"

bash <<'SCRIPT'
set -u

ROOT="$HOME/output 1"
OUT="$(mktemp -d "$ROOT/XXXXXXXX")"
ARCHIVE="$ROOT/$(basename "$OUT").tar.gz"

SOURCE="$(mktemp "$OUT/XXXXXXXX.cpp")"
F1="$(mktemp "$OUT/XXXXXXXX.log")"
F2="$(mktemp "$OUT/XXXXXXXX.log")"
F3="$(mktemp "$OUT/XXXXXXXX.log")"
F4="$(mktemp "$OUT/XXXXXXXX.log")"
F5="$(mktemp "$OUT/XXXXXXXX.log")"

WORKERS=4
MAX_SECONDS=12
TEMP_LIMIT=42
PIDS=()

get_temp() {
    local value raw

    if command -v termux-battery-status >/dev/null 2>&1; then
        value="$(timeout 2s termux-battery-status 2>/dev/null |
          sed -n 's/.*"temperature"[[:space:]]*:[[:space:]]*\([0-9.]*\).*/\1/p' |
          head -n 1)"
        if [[ -n "$value" ]]; then
            echo "$value"
            return
        fi
    fi

    raw="$(timeout 2s dumpsys battery 2>/dev/null |
      sed -n 's/.*temperature:[[:space:]]*\([0-9]*\).*/\1/p' |
      head -n 1)"

    if [[ "$raw" =~ ^[0-9]+$ ]]; then
        echo "$((raw / 10)).$((raw % 10))"
    fi
}

stop_workers() {
    for pid in "${PIDS[@]}"; do
        kill "$pid" 2>/dev/null || true
    done
}

trap stop_workers EXIT

{
    echo "DEVICE INFORMATION"
    date -u
    getprop ro.product.model
    getprop ro.build.version.release
    nproc
} > "$F1"

{
    echo '#include <cmath>'
    echo '#include <vector>'

    for i in $(seq 1 1000); do
        echo "double function_$i(double x) {"
        echo "  for (int k = 0; k < 100; ++k) {"
        echo "    x = std::sin(x + k + $i) + std::cos(x * 0.5);"
        echo "  }"
        echo "  return x;"
        echo "}"
    done
} > "$SOURCE"

TEMP="$(get_temp)"

echo "Starting temperature: ${TEMP:-unavailable} C" |
  tee "$F2"

if [[ -n "$TEMP" ]]; then
    TEMP_INT="${TEMP%%.*}"

    if [[ "$TEMP_INT" =~ ^[0-9]+$ ]] &&
       (( TEMP_INT >= TEMP_LIMIT )); then
        echo "ABORTED: Temperature too high." |
          tee -a "$F2"
        exit 1
    fi
fi

echo ""
echo "===== STARTING ====="

date -u '+UTC: %Y-%m-%dT%H:%M:%SZ' |
  tee -a "$F2"

echo "Workers: $WORKERS" | tee -a "$F2"

for worker in $(seq 1 "$WORKERS"); do

    OBJ="$OUT/$(basename "$(mktemp "$OUT/XXXXXXXX.o")")"
    LOG="$(mktemp "$OUT/XXXXXXXX.log")"

    timeout --signal=TERM --kill-after=2s \
      "${MAX_SECONDS}s" \
      clang++ -std=c++17 -O2 \
      -c "$SOURCE" \
      -o "$OBJ" \
      > "$LOG" 2>&1 &

    PIDS+=("$!")
done

for sample in $(seq 1 10); do

    NOW="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    TEMP="$(get_temp)"

    echo "$NOW battery_temperature=${TEMP:-unavailable}C" \
      >> "$F3"

    {
        echo ""
        echo "======== $NOW ========"
        top -b -n 1 2>&1 | head -n 35
    } >> "$F4"

    if [[ -n "$TEMP" ]]; then
        TEMP_INT="${TEMP%%.*}"

        if [[ "$TEMP_INT" =~ ^[0-9]+$ ]] &&
           (( TEMP_INT >= TEMP_LIMIT )); then
            echo "THERMAL STOP at $NOW" | tee -a "$F2"
            stop_workers
            break
        fi
    fi

    ACTIVE=0

    for pid in "${PIDS[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            ACTIVE=1
        fi
    done

    if (( ACTIVE == 0 )); then
        break
    fi

    sleep 2
done

for pid in "${PIDS[@]}"; do
    wait "$pid" 2>/dev/null
    CODE=$?
    echo "PID=$pid EXIT=$CODE" >> "$F5"
done

date -u '+UTC: %Y-%m-%dT%H:%M:%SZ' |
  tee -a "$F2"

tar -czf "$ARCHIVE" -C "$ROOT" "$(basename "$OUT")"

if [[ -d "$HOME/storage/downloads" ]]; then
    cp "$ARCHIVE" "$HOME/storage/downloads/"
fi

echo ""
echo "===== COMPLETE ====="
echo "Saved: $ARCHIVE"
echo "Upload the .tar.gz file."
SCRIPT
