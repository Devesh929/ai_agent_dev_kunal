pkg install python clang -y

cat > ~/compile_test.py <<'PY'
import os
import time
import json
import signal
import secrets
import subprocess
import tempfile
from pathlib import Path
from datetime import datetime

WORKERS = 4
ACTIVE_SECONDS = 45
REST_SECONDS = 45
CYCLES = 2

folder = Path.home() / "storage/downloads/output 1"
if not folder.parent.exists():
    folder = Path.home() / "output 1"
folder.mkdir(parents=True, exist_ok=True)

filename = "run_" + secrets.token_hex(5)
logfile = folder / (filename + ".json")

records = []
processes = []
completed = 0
failed = 0

def timestamp():
    return datetime.now().astimezone().isoformat()

def record(event, **details):
    item = {"timestamp": timestamp(), "event": event, **details}
    records.append(item)
    print(item, flush=True)
    logfile.write_text(json.dumps(records, indent=2))

def stop_all():
    for p in processes:
        if p.poll() is None:
            try:
                os.killpg(p.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
    for p in processes:
        try:
            p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

source = r"""
#include <vector>
#include <algorithm>
#include <numeric>
#include <cmath>
#include <array>

template<int N>
struct Calculation {
    static double compute(double x) {
        return std::sqrt(
            Calculation<N-1>::compute(x) + 1.0
        ) + std::sin(x);
    }
};

template<>
struct Calculation<0> {
    static double compute(double x) {
        return x * 1.000001;
    }
};

double run(std::vector<double> data) {
    std::sort(data.begin(), data.end());

    double result = 0.0;

    for (double x : data) {
        result += Calculation<90>::compute(x);
    }

    return result;
}
"""

try:
    with tempfile.TemporaryDirectory() as temp:
        temp = Path(temp)

        for cycle in range(1, CYCLES + 1):
            record("build_start", cycle=cycle)
            started = time.monotonic()
            processes = []

            while time.monotonic() - started < ACTIVE_SECONDS:
                for p in list(processes):
                    if p.poll() is not None:
                        if p.returncode == 0:
                            completed += 1
                        else:
                            failed += 1
                        processes.remove(p)

                while len(processes) < WORKERS:
                    n = completed + failed + len(processes)
                    src = temp / f"task_{cycle}_{n}.cpp"
                    obj = temp / f"task_{cycle}_{n}.o"

                    src.write_text(source)

                    p = subprocess.Popen(
                        [
                            "clang++",
                            "-std=c++17",
                            "-O2",
                            "-c",
                            str(src),
                            "-o",
                            str(obj)
                        ],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True
                    )
                    processes.append(p)

                if int(time.monotonic() - started) % 5 == 0:
                    print(
                        f"Cycle {cycle} | "
                        f"Elapsed {int(time.monotonic()-started)}s | "
                        f"Running {len(processes)}",
                        flush=True
                    )

                time.sleep(1)

            stop_all()
            processes = []

            record(
                "build_end",
                cycle=cycle,
                completed=completed,
                failed=failed
            )

            if cycle < CYCLES:
                record("idle_start", seconds=REST_SECONDS)
                time.sleep(REST_SECONDS)
                record("idle_end")

except KeyboardInterrupt:
    record("interrupted")
finally:
    stop_all()
    record(
        "finished",
        completed=completed,
        failed=failed
    )

print("\nLogs saved to:", logfile)
PY

python ~/compile_test.py
